{
  "name": "claude-secrets",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "secretd": "./dist/daemon/main.js",
    "secrets": "./dist/cli/main.js",
    "secrets-mcp": "./dist/mcp/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/ui','dist/ui',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --no-warnings --test dist/test/*.test.js",
    "daemon": "node --no-warnings dist/daemon/main.js",
    "test:ui": "npm run build && node --no-warnings --test dist/test/*.smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "libsodium-wrappers-sumo": "^0.7.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.10.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  }
}
